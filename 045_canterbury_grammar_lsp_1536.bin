;; Canterbury Corpus Symbolic Grammar & Parser Rules
(define (make-grammar-rule lhs rhs-list weight)
  (list 'rule (cons 'lhs lhs) (cons 'rhs rhs-list) (cons 'weight weight)))

(define (evaluate-production-cost state symbol-table offset-bits)
  (let ((base-cost (lookup-state-cost state symbol-table))
        (elias-len (compute-elias-gamma-bits (state-run-length state))))
    (+ base-cost elias-len offset-bits)))

(define rule-production-01
  (make-grammar-rule 'non-terminal-01
    '(terminal-alpha-01 non-terminal-02 terminal-beta-01)
    10))
