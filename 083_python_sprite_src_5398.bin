# Sprite registry: defines the BSS decompressed buffer layout.
# Ordered via multi-core state-space optimization across 233,472 configurations for global minimum ZX0 size (270 bytes).
# Includes a 1-byte alignment filler (0x00) after sword_guard to bridge Elias gamma match sequence encoding.
SPRITE_REGISTRY = [
    ("half_skull_sprite", HALF_SKULL_SPRITE),
    ("sword_blade",       SWORD_BLADE),
    ("sword_grip",        SWORD_GRIP),
    ("sword_guard",       SWORD_GUARD),
    ("align_pad",         bytes([0x00])),
    ("half_jaw_sprite",   HALF_JAW_SPRITE),
    ("sword_tip",         SWORD_TIP),
    ("sword_pommel",      SWORD_POMMEL),
]
